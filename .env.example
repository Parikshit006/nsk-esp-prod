# Copy to .env and supply your own database credentials and readiness token.
NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=postgresql://esp:CHANGE_ME@127.0.0.1:5432/esp
DATABASE_URL_TEST=postgresql://esp:CHANGE_ME@127.0.0.1:5432/esp_test
READINESS_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# 32 random bytes encoded as 64 hexadecimal characters; keep and back up securely.
CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
# Required in production for password recovery. Use a dedicated SMTP account.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=false
