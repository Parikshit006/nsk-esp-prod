# Copy to .env and supply your own database credentials and readiness token.
NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=postgresql://esp:CHANGE_ME@127.0.0.1:5432/esp
DATABASE_URL_TEST=postgresql://esp:CHANGE_ME@127.0.0.1:5432/esp_test
# Compose database password. Use random URL-safe characters (for example hexadecimal) because Compose also places it in DATABASE_URL.
POSTGRES_PASSWORD=CHANGE_ME
READINESS_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# 32 random bytes encoded as 64 hexadecimal characters; keep and back up securely.
CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
# During planned room-key rotation only, set CREDENTIAL_ENCRYPTION_KEY_PREVIOUS to the old 64-hex key; remove after the atomic re-encryption check.
# Required in production for password recovery. Use a dedicated SMTP account.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=false
# Optional Google and Discord sign-in. Configure matching OAuth applications and exact callback URLs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
